<Window x:Class="PersonalViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PersonalViewer.Localization"
        Title="{loc:Loc AppTitle}"
        Icon="pack://application:,,,/app-icon.ico"
        Width="1000"
        Height="660"
        MinWidth="800"
        MinHeight="520"
        Background="#F3F5F8"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="BorderBrush" Color="#DCE1E8" />
        <SolidColorBrush x:Key="MutedBrush" Color="#77808D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3478C8" />

        <Style x:Key="ToolbarButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="MinWidth" Value="94" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#303844" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EAF2FC" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#205B9D" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F4F7FB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#303844" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <ItemsPanelTemplate x:Key="ResultsItemsPanelTemplate">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="ThumbnailItemsPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="ThumbnailResultTemplate">
            <Border Width="136"
                    Margin="2"
                    Padding="4"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Bottom"
                               MaxHeight="36"
                               Margin="0,3,0,0"
                               Text="{Binding FileName}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"
                               ToolTip="{Binding FileName}" />
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="1"
                            Background="#F3F5F8"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <Grid MinWidth="96" MinHeight="54">
                            <Image MaxWidth="96"
                                   MaxHeight="96"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Source="{Binding Thumbnail}"
                                   Stretch="Uniform" />
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="{loc:Loc NoThumbnail}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0"
              Background="White"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="4,2">
            <MenuItem Header="{loc:Loc MenuFile}">
                <MenuItem x:Name="NewProjectMenuItem"
                          Header="{loc:Loc MenuNewProject}"
                          Click="NewProjectMenuItem_Click" />
                <MenuItem x:Name="AddFolderMenuItem"
                          Header="{loc:Loc MenuAddFolder}"
                          Click="AddFolderMenuItem_Click" />
                <Separator />
                <MenuItem Header="{loc:Loc MenuExit}"
                          Click="ExitMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="{loc:Loc MenuHelp}">
                <MenuItem Header="{loc:Loc MenuAbout}"
                          Click="AboutMenuItem_Click" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Height="36"
                        Margin="0,0,12,0"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5">
                    <Grid>
                        <TextBlock Text="⌕"
                                   Margin="11,0,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="SearchTextBox"
                                 Margin="38,0,8,0"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ToolTip="{loc:Loc SearchPlaceholder}"
                                 TextChanged="SearchTextBox_TextChanged" />
                        <TextBlock x:Name="SearchPlaceholderText"
                                   Text="{loc:Loc SearchPlaceholder}"
                                   Margin="38,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="#9AA2AD"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <ComboBox x:Name="ProjectComboBox"
                          Grid.Column="1"
                          Height="36"
                          Margin="0,0,8,0"
                          VerticalContentAlignment="Center"
                          IsEditable="False"
                          SelectionChanged="ProjectComboBox_SelectionChanged"
                          ToolTip="{loc:Loc SelectProject}" />

                <ToggleButton x:Name="DetailsViewButton"
                              Grid.Column="2"
                              Style="{StaticResource ToolbarButtonStyle}"
                              Content="{loc:Loc ViewDetails}"
                              IsChecked="True"
                              Click="DetailsViewButton_Click"
                              ToolTip="{loc:Loc ViewDetailsTooltip}" />

                <ToggleButton x:Name="ThumbnailViewButton"
                              Grid.Column="3"
                              Style="{StaticResource ToolbarButtonStyle}"
                              Content="{loc:Loc ViewThumbnails}"
                              Click="ThumbnailViewButton_Click"
                              ToolTip="{loc:Loc ViewThumbnailsTooltip}" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                MinHeight="46"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#46505D"
                           Text="{loc:Loc SelectedTags}" />
                <Grid Grid.Column="1">
                    <TextBlock x:Name="TagPlaceholderText"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               Text="{loc:Loc SelectFilesTagsPlaceholder}" />
                    <ScrollViewer MaxHeight="72"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="SelectedTagsItemsControl"
                                      Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,6,4"
                                            Padding="8,3"
                                            Background="#EEF3F8"
                                            BorderBrush="#DCE4ED"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="{Binding Name}" />
                                            <TextBlock Margin="5,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Text="{Binding CountText}" />
                                            <Button Margin="5,0,0,0"
                                                    Padding="0"
                                                    Width="18"
                                                    Height="18"
                                                    Content="×"
                                                    Tag="{Binding Name}"
                                                    Click="RemoveTagButton_Click"
                                                    ToolTip="{loc:Loc RemoveTag}">
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanRemove}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBox x:Name="NewTagTextBox"
                             Width="240"
                             HorizontalAlignment="Left"
                             VerticalContentAlignment="Center"
                             Visibility="Collapsed"
                             ToolTip="{loc:Loc AddTagInput}"
                             KeyDown="NewTagTextBox_KeyDown" />
                </Grid>
                <Button x:Name="AddTagButton"
                        Grid.Column="2"
                        Width="32"
                        Height="30"
                        Margin="8,0,0,0"
                        Padding="0"
                        Style="{StaticResource ToolbarButton}"
                        Content="+"
                        FontSize="19"
                        IsEnabled="False"
                        Click="AddTagButton_Click"
                        ToolTip="{loc:Loc AddTag}" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="12,10,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Padding="12,10"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="#303844"
                                   Text="{loc:Loc FolderSection}" />
                    </Border>
                    <Grid>
                        <TreeView x:Name="FolderTreeView"
                                  Margin="6"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  SelectedItemChanged="FolderTreeView_SelectedItemChanged" />
                        <TextBlock x:Name="FolderPlaceholderText"
                                   Margin="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="{loc:Loc FolderPlaceholder}"
                                   IsHitTestVisible="False" />
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Padding="12,10"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       FontWeight="SemiBold"
                                       Foreground="#303844"
                                       Text="{loc:Loc ResultsTitle}" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="ResultCountText"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="{loc:Loc ResultCountInitial}" />
                                <StackPanel x:Name="ThumbnailSortPanel"
                                            Margin="14,0,0,0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                    <TextBlock Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="{loc:Loc SortOrder}" />
                                    <ComboBox x:Name="ThumbnailSortComboBox"
                                              Width="172"
                                              Height="28"
                                              VerticalContentAlignment="Center"
                                              SelectionChanged="ThumbnailSortComboBox_SelectionChanged"
                                              ToolTip="{loc:Loc ThumbnailSortTooltip}">
                                        <ComboBoxItem Content="{loc:Loc NameAscending}" />
                                        <ComboBoxItem Content="{loc:Loc ModifiedOldest}" />
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid>
                        <ListView x:Name="ResultsListView"
                                  Margin="6"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ItemsPanel="{StaticResource ResultsItemsPanelTemplate}"
                                  SelectionMode="Extended"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  MouseDoubleClick="ResultsListView_MouseDoubleClick"
                                  PreviewMouseRightButtonDown="ResultsListView_PreviewMouseRightButtonDown"
                                  ContextMenuOpening="ResultsListView_ContextMenuOpening"
                                  SelectionChanged="ResultsListView_SelectionChanged"
                                  GridViewColumnHeader.Click="ResultsListView_ColumnHeaderClick">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:Loc ShowInExplorer}"
                                              Click="ShowInExplorerMenuItem_Click" />
                                    <Separator Tag="ThumbnailReselectSeparator" />
                                    <MenuItem Tag="ThumbnailReselect"
                                              Header="{loc:Loc ThumbnailReselect}"
                                              Click="ThumbnailReselectMenuItem_Click" />
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView x:Name="DetailsGridView">
                                    <GridViewColumn Header="{loc:Loc ColumnFileName}"
                                                    Width="360"
                                                    DisplayMemberBinding="{Binding FileName}" />
                                    <GridViewColumn Header="{loc:Loc ColumnLastModified}"
                                                    Width="155"
                                                    DisplayMemberBinding="{Binding LastModifiedLocal, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}" />
                                    <GridViewColumn Header="{loc:Loc ColumnType}"
                                                    Width="90"
                                                    DisplayMemberBinding="{Binding FileType}" />
                                    <GridViewColumn Header="{loc:Loc ColumnSize}"
                                                    Width="110"
                                                    DisplayMemberBinding="{Binding FileSize}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock x:Name="ResultEmptyText"
                                   Margin="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="{loc:Loc EmptyResultsPrompt}"
                                   IsHitTestVisible="False" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,0">
            <TextBlock VerticalAlignment="Center"
                       Foreground="#65707D"
                       x:Name="StatusText"
                       Text="" />
        </Border>
    </Grid>
</Window>
