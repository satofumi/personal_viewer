<Window x:Class="PersonalViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personal Viewer"
        Width="1000"
        Height="660"
        MinWidth="800"
        MinHeight="520"
        Background="#F3F5F8"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="BorderBrush" Color="#DCE1E8" />
        <SolidColorBrush x:Key="MutedBrush" Color="#77808D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3478C8" />

        <Style x:Key="ToolbarButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="MinWidth" Value="94" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#303844" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EAF2FC" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#205B9D" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F4F7FB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#303844" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <ItemsPanelTemplate x:Key="ResultsItemsPanelTemplate">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="ThumbnailItemsPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="ThumbnailResultTemplate">
            <Border Width="144"
                    Height="124"
                    Margin="3"
                    Padding="6"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Bottom"
                               MaxHeight="36"
                               Margin="0,4,0,0"
                               Text="{Binding FileName}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"
                               ToolTip="{Binding FileName}" />
                    <Grid Width="128"
                          Height="72"
                          Background="#F3F5F8">
                        <Image MaxWidth="96"
                               MaxHeight="96"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Source="{Binding Thumbnail}"
                               Stretch="Uniform" />
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="サムネイルなし">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0"
              Background="White"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem x:Name="NewProjectMenuItem"
                          Header="新規プロジェクト..."
                          Click="NewProjectMenuItem_Click" />
                <MenuItem x:Name="AddFolderMenuItem"
                          Header="プロジェクトにフォルダーを追加..."
                          Click="AddFolderMenuItem_Click" />
                <Separator />
                <MenuItem Header="終了" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="このアプリケーションについて" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Height="36"
                        Margin="0,0,12,0"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5">
                    <Grid>
                        <TextBlock Text="⌕"
                                   Margin="11,0,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="SearchTextBox"
                                 Margin="38,0,8,0"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ToolTip="ファイル名またはタグで検索"
                                 TextChanged="SearchTextBox_TextChanged" />
                        <TextBlock x:Name="SearchPlaceholderText"
                                   Text="ファイル名またはタグで検索"
                                   Margin="38,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="#9AA2AD"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <ComboBox x:Name="ProjectComboBox"
                          Grid.Column="1"
                          Height="36"
                          Margin="0,0,8,0"
                          VerticalContentAlignment="Center"
                          IsEditable="False"
                          SelectionChanged="ProjectComboBox_SelectionChanged"
                          ToolTip="プロジェクトを選択" />

                <ToggleButton x:Name="DetailsViewButton"
                              Grid.Column="2"
                              Style="{StaticResource ToolbarButtonStyle}"
                              Content="☷  詳細表示"
                              IsChecked="True"
                              Click="DetailsViewButton_Click"
                              ToolTip="詳細表示" />

                <ToggleButton x:Name="ThumbnailViewButton"
                              Grid.Column="3"
                              Style="{StaticResource ToolbarButtonStyle}"
                              Content="▦  サムネイル"
                              Click="ThumbnailViewButton_Click"
                              ToolTip="サムネイル表示" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                MinHeight="46"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,7">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Width="32"
                        Height="30"
                        Margin="8,0,0,0"
                        Padding="0"
                        Style="{StaticResource ToolbarButton}"
                        Content="+"
                        FontSize="19"
                        IsEnabled="False"
                        ToolTip="タグを追加" />
                <TextBlock DockPanel.Dock="Left"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#46505D"
                           Text="選択中のタグ" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           Text="ファイルを選択するとタグがここに表示されます" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="3" Margin="12,10,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Padding="12,10"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="#303844"
                                   Text="フォルダー" />
                    </Border>
                    <Grid>
                        <TreeView x:Name="FolderTreeView"
                                  Margin="6"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  SelectedItemChanged="FolderTreeView_SelectedItemChanged" />
                        <TextBlock x:Name="FolderPlaceholderText"
                                   Margin="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="プロジェクトを選択すると&#10;フォルダーがここに表示されます"
                                   IsHitTestVisible="False" />
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Padding="12,10"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="#303844"
                                       Text="検索結果" />
                            <TextBlock x:Name="ResultCountText"
                                       DockPanel.Dock="Right"
                                       Margin="12,0,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="0 件" />
                        </DockPanel>
                    </Border>
                    <Grid>
                        <ListView x:Name="ResultsListView"
                                  Margin="6"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ItemsPanel="{StaticResource ResultsItemsPanelTemplate}"
                                  SelectionMode="Extended"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  GridViewColumnHeader.Click="ResultsListView_ColumnHeaderClick">
                            <ListView.View>
                                <GridView x:Name="DetailsGridView">
                                    <GridViewColumn Header="ファイル名"
                                                    Width="360"
                                                    DisplayMemberBinding="{Binding FileName}" />
                                    <GridViewColumn Header="更新日時"
                                                    Width="155"
                                                    DisplayMemberBinding="{Binding LastModifiedLocal, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}" />
                                    <GridViewColumn Header="種類"
                                                    Width="90"
                                                    DisplayMemberBinding="{Binding FileType}" />
                                    <GridViewColumn Header="サイズ"
                                                    Width="110"
                                                    DisplayMemberBinding="{Binding FileSize}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock x:Name="ResultEmptyText"
                                   Margin="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="検索欄にキーワードを入力するか、&#10;フォルダーを選択してください"
                                   IsHitTestVisible="False" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,0">
            <TextBlock VerticalAlignment="Center"
                       Foreground="#65707D"
                       x:Name="StatusText"
                       Text="" />
        </Border>
    </Grid>
</Window>
