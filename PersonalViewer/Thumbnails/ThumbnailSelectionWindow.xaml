<Window x:Class="PersonalViewer.Thumbnails.ThumbnailSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PersonalViewer.Localization"
        Title="{loc:Loc ThumbnailSelectionTitle}"
        Width="560"
        Height="460"
        MinWidth="540"
        MinHeight="440"
        Background="#F3F5F8"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="FileNameTextBlock"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#303844"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="StatusTextBlock"
                       Margin="0,5,0,0"
                       Foreground="#77808D"
                       Text="{loc:Loc ThumbnailCandidateProgress}" />
        </StackPanel>

        <ListBox x:Name="CandidateListBox"
                 Grid.Row="1"
                 Margin="0,14,0,12"
                 Background="Transparent"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionMode="Single"
                 SelectionChanged="CandidateListBox_SelectionChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" Rows="3" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Margin" Value="1" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <Border x:Name="CandidateBorder"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="White"
                                        BorderBrush="#DCE1E8"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="2">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="CandidateBorder" Property="Background" Value="#EAF2FC" />
                                        <Setter TargetName="CandidateBorder" Property="BorderBrush" Value="#3478C8" />
                                        <Setter TargetName="CandidateBorder" Property="BorderThickness" Value="2" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel HorizontalAlignment="Center">
                        <Border HorizontalAlignment="Center"
                                Background="#F3F5F8"
                                BorderBrush="#DCE1E8"
                                BorderThickness="1"
                                Padding="1">
                            <Image MaxWidth="96"
                                   MaxHeight="96"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Source="{Binding Preview}"
                                   Stretch="Uniform" />
                        </Border>
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="#303844"
                                   Text="{Binding TimeLabel}"
                                   TextAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button x:Name="UseThumbnailButton"
                    MinWidth="128"
                    Height="32"
                    Margin="0,0,8,0"
                    Padding="12,0"
                    Content="{loc:Loc UseSelectedThumbnail}"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="UseThumbnailButton_Click" />
            <Button MinWidth="88"
                    Height="32"
                    Padding="12,0"
                    Content="{loc:Loc Cancel}"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
