<Window x:Class="PersonalViewer.Projects.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新規プロジェクト"
        Width="540"
        Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F8"
        FontFamily="Segoe UI"
        FontSize="13">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,18"
                   FontSize="19"
                   FontWeight="SemiBold"
                   Foreground="#303844"
                   Text="新規プロジェクト" />

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Foreground="#46505D" Text="プロジェクト名" />
            <TextBox x:Name="ProjectNameTextBox"
                     Height="34"
                     Margin="0,6,0,0"
                     Padding="8,4"
                     VerticalContentAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Foreground="#46505D" Text="メディア種別" />
            <ComboBox x:Name="MediaTypeComboBox"
                      Height="34"
                      Margin="0,6,0,0"
                      Padding="8,4"
                      DisplayMemberPath="Name"
                      VerticalContentAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Foreground="#46505D" Text="登録フォルダー" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderPathTextBox"
                         Height="34"
                         Padding="8,4"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center" />
                <Button x:Name="BrowseFolderButton"
                        Grid.Column="1"
                        Width="92"
                        Height="34"
                        Margin="8,0,0,0"
                        Padding="10,0"
                        Content="参照..."
                        Click="BrowseFolder_Click" />
            </Grid>
        </StackPanel>

        <TextBlock x:Name="ValidationMessage"
                   Grid.Row="4"
                   Margin="0,4,0,0"
                   VerticalAlignment="Top"
                   Foreground="#B42318"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
            <Button Width="88"
                    Height="34"
                    Margin="0,0,8,0"
                    Content="キャンセル"
                    IsCancel="True" />
            <Button Width="104"
                    Height="34"
                    Content="作成"
                    IsDefault="True"
                    Click="CreateProject_Click" />
        </StackPanel>
    </Grid>
</Window>
